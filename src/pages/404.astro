---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_OWNER } from '../data/site';
---

<BaseLayout
  locale="tr"
  title={`Sayfa Bulunamadı (404) · ${SITE_OWNER.fullName}`}
  description="Aradığınız sayfa bulunamadı veya taşınmış olabilir. / The page you are looking for could not be found."
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-6 sm:py-28">
    <!-- 3-Tone Crisp-Pixel Explorer Mascot (Zero-JS, Pure CSS, Reduced-Motion Safe) -->
    <div aria-hidden="true" class="mx-auto mb-5 flex justify-center select-none">
      <svg
        width="96"
        height="96"
        viewBox="0 0 32 32"
        shape-rendering="crispEdges"
        class="nf-mascot block h-[96px] w-[96px] overflow-visible"
      >
        <!-- Soft pixel ground shadow -->
        <rect x="8" y="29" width="16" height="2" fill="#e2e8f0" />
        <rect x="10" y="29" width="12" height="1" fill="#cbd5e1" />

        <!-- Floating pixel '?' mark in FolioPeek Amber -->
        <g class="nf-qmark">
          <rect x="14" y="2" width="4" height="1" fill="#fbbf24" />
          <rect x="13" y="3" width="2" height="1" fill="#ea7b24" />
          <rect x="17" y="3" width="2" height="2" fill="#ea7b24" />
          <rect x="15" y="5" width="2" height="2" fill="#ea7b24" />
          <rect x="15" y="8" width="2" height="2" fill="#b45309" />
        </g>

        <!-- 3-Tone Emerald TablePeek Explorer Character -->
        <g class="nf-char">
          <!-- Little feet -->
          <rect x="11" y="26" width="3" height="3" fill="#065f46" />
          <rect x="17" y="26" width="3" height="3" fill="#065f46" />

          <!-- Left resting arm -->
          <rect x="7" y="20" width="2" height="3" fill="#047857" />

          <!-- 3-Tone Body (shadow / main / top highlight) -->
          <rect x="9" y="13" width="13" height="13" fill="#047857" />
          <rect x="10" y="12" width="11" height="13" fill="#10b981" />
          <rect x="11" y="12" width="9" height="2" fill="#6ee7b7" />

          <!-- Pixel Glasses -->
          <rect x="10" y="16" width="5" height="4" fill="#064e3b" />
          <rect x="16" y="16" width="5" height="4" fill="#064e3b" />
          <rect x="15" y="17" width="1" height="1" fill="#064e3b" />
          <rect x="11" y="17" width="3" height="2" fill="#ecfdf5" />
          <rect x="17" y="17" width="3" height="2" fill="#ecfdf5" />

          <!-- Curious looking-around pupils -->
          <g class="nf-pupils">
            <rect x="12" y="17" width="1" height="2" fill="#0f172a" />
            <rect x="18" y="17" width="1" height="2" fill="#0f172a" />
          </g>

          <!-- Mini table grid mark on chest -->
          <rect x="13" y="22" width="5" height="3" fill="#d1fae5" />
          <rect x="15" y="22" width="1" height="3" fill="#047857" />

          <!-- Right arm holding bright pixel magnifier -->
          <g class="nf-magnifier">
            <rect x="21" y="20" width="3" height="2" fill="#047857" />
            <rect x="23" y="18" width="2" height="3" fill="#064e3b" />
            <!-- Magnifier rim & gleaming glass -->
            <rect x="24" y="12" width="6" height="6" fill="#064e3b" />
            <rect x="25" y="13" width="4" height="4" fill="#a7f3d0" />
            <rect x="25" y="13" width="1" height="1" fill="#ffffff" />
            <rect x="26" y="14" width="1" height="1" fill="#ecfdf5" />
          </g>
        </g>
      </svg>
    </div>

    <p class="text-xs font-semibold tracking-wider text-ink-secondary uppercase">404</p>
    <h1 class="mt-2.5 text-balance text-3xl font-semibold tracking-[-0.03em] text-ink-primary sm:text-4xl">
      Aradığınız sayfa bulunamadı.
    </h1>
    <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-ink-secondary sm:text-base">
      Bağlantı değişmiş veya sayfa taşınmış olabilir. Uygulamalar ve gizlilik belgeleri için aşağıdaki
      bağlantıları kullanabilirsiniz.
    </p>
    <p class="mx-auto mt-2 max-w-lg text-xs leading-relaxed text-ink-secondary sm:text-sm" lang="en">
      The page you are looking for could not be found. Browse the links below to return home or view apps.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
      >
        Ana Sayfa
      </a>
      <a
        href="/apps/"
        class="inline-flex items-center justify-center rounded-full border border-border-subtle bg-white px-5 py-2.5 text-sm font-medium text-ink-primary transition-colors hover:bg-surface-apple"
      >
        Uygulamalar
      </a>
      <a
        href="/en/"
        hreflang="en"
        lang="en"
        class="inline-flex items-center justify-center rounded-full border border-border-subtle bg-white px-5 py-2.5 text-sm font-medium text-ink-primary transition-colors hover:bg-surface-apple"
      >
        English Home
      </a>
    </div>
  </section>
</BaseLayout>
