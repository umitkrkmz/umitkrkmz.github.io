---
import type { Locale } from '../data/site';
import { SITE_OWNER } from '../data/site';
import { UI_STRINGS, getLocalePath } from '../data/ui';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI_STRINGS[locale];
const pathname = Astro.url.pathname;

const homeHref = getLocalePath(locale, '/');
const appsHref = getLocalePath(locale, '/apps/');
const projectsHref = getLocalePath(locale, '/projects/');
const aboutHref = getLocalePath(locale, '/about/');
const contactHref = `${aboutHref}#contact`;

const isAppsActive = pathname.includes('/apps/');
const isProjectsActive = pathname.includes('/projects/');
const isAboutActive = pathname.includes('/about/');

const navItems = [
  { label: ui.nav.apps, href: appsHref, active: isAppsActive },
  { label: ui.nav.projects, href: projectsHref, active: isProjectsActive },
  { label: ui.nav.about, href: aboutHref, active: isAboutActive },
  { label: ui.nav.contact, href: contactHref, active: false },
];
---

<header class="sticky top-0 z-40 border-b border-border-subtle/80 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6 lg:px-8">
    <a
      href={homeHref}
      class="truncate text-[15px] font-semibold tracking-[-0.015em] text-ink-primary transition-opacity hover:opacity-75"
    >
      {SITE_OWNER.fullName}
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label={ui.nav.primaryNavLabel} class="hidden items-center gap-7 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors',
            item.active
              ? 'font-medium text-ink-primary'
              : 'text-ink-secondary hover:text-ink-primary',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <LanguageSwitch locale={locale} />

      <!-- Zero-JS Accessible Mobile Menu -->
      <details class="relative md:hidden">
        <summary
          aria-label={ui.nav.menuOpen}
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-border-subtle bg-white text-ink-primary transition-colors hover:bg-surface-apple [&::-webkit-details-marker]:hidden"
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2.5 w-56 rounded-2xl border border-border-subtle bg-white p-2 shadow-[0_16px_40px_-12px_rgba(0,0,0,0.12)]">
          <nav aria-label={ui.nav.primaryNavLabel} class="flex flex-col">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-3.5 py-2.5 text-sm transition-colors',
                  item.active
                    ? 'bg-surface-apple font-medium text-ink-primary'
                    : 'text-ink-secondary hover:bg-surface-apple hover:text-ink-primary',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
