---
import { getCollection } from 'astro:content';
import type { Locale } from '../data/site';
import { SITE_OWNER } from '../data/site';
import { UI_STRINGS, getAlternatePath, getLocalePath } from '../data/ui';
import FooterPixelWorkshop from './FooterPixelWorkshop.astro';

interface Props {
  locale: Locale;
  showClosingCard?: boolean;
}

const { locale, showClosingCard = true } = Astro.props;
const ui = UI_STRINGS[locale];

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const alternateLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const alternateHref = getAlternatePath(Astro.url.pathname, alternateLocale);
const alternateLabel = locale === 'tr' ? 'English' : 'Türkçe';

const closingCopy =
  locale === 'tr'
    ? {
        heading: 'İletişime geçin',
        body: 'Mühendislik rolleri, iş birlikleri veya uygulamalarla ilgili destek için doğrudan yazabilirsiniz.',
        emailCta: 'E-posta Gönder',
      }
    : {
        heading: 'Get in touch',
        body: 'Write directly for engineering roles, collaborations, or support with any of my Windows apps.',
        emailCta: 'Send Email',
      };
---

<footer class="mt-24 border-t border-border-subtle bg-surface-apple">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-14 lg:px-8">
    <!-- Companion Editorial Closing Card -->
    {showClosingCard && (
      <div class="relative mb-12 overflow-hidden rounded-3xl border border-black/[0.06] bg-[#f7f7f9] p-7 sm:p-10 lg:mb-14 lg:px-12 lg:py-11">
        <img
          src="/images/footer/closing-cover.webp"
          alt=""
          width="1600"
          height="420"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover object-right"
        />
        <!-- Mobile readability wash + directional desktop scrim -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-white/70 lg:bg-transparent"
        ></div>
        <div
          aria-hidden="true"
          style="background: linear-gradient(90deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.82) 52%, rgba(255,255,255,0.16) 100%);"
          class="pointer-events-none absolute inset-0"
        ></div>

        <div class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
          <div class="min-w-0 max-w-lg flex-1">
            <h2 class="text-2xl font-semibold tracking-[-0.025em] text-ink-primary sm:text-[28px]">
              {closingCopy.heading}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-secondary sm:text-[15px]">
              {closingCopy.body}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 lg:max-w-[440px] lg:justify-end">
            <a
              href={`mailto:${SITE_OWNER.email}`}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
            >
              <svg
                aria-hidden="true"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2.5" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              <span>{closingCopy.emailCta}</span>
            </a>

            <a
              href={SITE_OWNER.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 rounded-full border border-black/10 bg-white/92 px-4 py-2.5 text-sm font-medium text-ink-primary shadow-[0_2px_8px_rgba(0,0,0,0.04)] backdrop-blur-sm transition-colors hover:bg-white"
            >
              <span>LinkedIn</span>
              <span aria-hidden="true" class="text-xs text-ink-secondary">↗</span>
            </a>

            <a
              href={SITE_OWNER.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 rounded-full border border-black/10 bg-white/92 px-4 py-2.5 text-sm font-medium text-ink-primary shadow-[0_2px_8px_rgba(0,0,0,0.04)] backdrop-blur-sm transition-colors hover:bg-white"
            >
              <span>GitHub</span>
              <span aria-hidden="true" class="text-xs text-ink-secondary">↗</span>
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- 3-Column Balanced Navigation Grid -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr] lg:gap-12">
      <!-- Column 1: Apps + Right-Aligned Privacy & Support -->
      <div class="md:col-span-2 lg:col-span-1">
        <h3 class="text-xs font-semibold tracking-wider text-ink-primary uppercase">
          {ui.footer.appsColumn}
        </h3>
        <ul class="mt-4 divide-y divide-border-subtle/60 text-sm">
          {apps.map(({ data }) => (
            <li class="flex items-center justify-between gap-4 py-2 first:pt-0 last:pb-0">
              <a
                href={getLocalePath(locale, `/apps/${data.slug}/`)}
                class="group inline-flex min-w-0 items-center gap-2.5 font-medium text-ink-primary transition-colors hover:text-accent-link"
              >
                <img
                  src={data.icon}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0 rounded-[4px]"
                />
                <span class="truncate">{data.name}</span>
              </a>

              <div class="flex shrink-0 items-center gap-2 text-xs text-ink-secondary">
                <a
                  href={getLocalePath(locale, `/apps/${data.slug}/privacy/`)}
                  class="transition-colors hover:text-ink-primary"
                >
                  {ui.footer.privacyLabel}
                </a>
                <span aria-hidden="true" class="opacity-45">·</span>
                <a
                  href={getLocalePath(locale, `/apps/${data.slug}/support/`)}
                  class="transition-colors hover:text-ink-primary"
                >
                  {ui.footer.supportLabel}
                </a>
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-3.5 text-sm">
          <a
            href={getLocalePath(locale, '/apps/')}
            class="font-medium text-accent-link transition-opacity hover:opacity-80"
          >
            {ui.actions.exploreApps} →
          </a>
        </div>
      </div>

      <!-- Column 2: Engineering -->
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-ink-primary uppercase">
          {ui.footer.engineeringColumn}
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {projects.map(({ data }) => (
            <li>
              <a
                href={data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-secondary transition-colors hover:text-ink-primary"
              >
                {data[locale].title}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a
              href={getLocalePath(locale, '/projects/')}
              class="font-medium text-accent-link transition-opacity hover:opacity-80"
            >
              {ui.footer.allProjects} →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact (with refined thin monochrome SVG icons) -->
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-ink-primary uppercase">
          {ui.footer.contactColumn}
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a
              href={getLocalePath(locale, '/about/')}
              class="inline-flex items-center gap-2 text-ink-secondary transition-colors hover:text-ink-primary"
            >
              <svg
                aria-hidden="true"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 opacity-75"
              >
                <circle cx="12" cy="8" r="4" />
                <path d="M5 20a7 7 0 0 1 14 0" />
              </svg>
              <span>{ui.nav.about}</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE_OWNER.email}`}
              class="inline-flex items-center gap-2 break-all text-ink-secondary transition-colors hover:text-ink-primary"
            >
              <svg
                aria-hidden="true"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 opacity-75"
              >
                <rect x="2" y="4" width="20" height="16" rx="2.5" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              <span>{SITE_OWNER.email}</span>
            </a>
          </li>
          <li>
            <a
              href={SITE_OWNER.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-ink-secondary transition-colors hover:text-ink-primary"
            >
              <svg
                aria-hidden="true"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 opacity-75"
              >
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href={SITE_OWNER.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-ink-secondary transition-colors hover:text-ink-primary"
            >
              <svg
                aria-hidden="true"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 opacity-75"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Full-Width 4-Station Pixel Workshop Strip (sits right on the bottom divider) -->
    <FooterPixelWorkshop />

    <!-- Bottom Copyright & Route-Preserving Language Switch Row -->
    <div class="flex flex-col gap-3 border-t border-border-subtle pt-6 text-xs text-ink-secondary sm:flex-row sm:items-center sm:justify-between">
      <p>{ui.footer.copyright}</p>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <span>{locale === 'tr' ? 'Ankara, Türkiye' : 'Ankara, Turkey'}</span>
        <span aria-hidden="true" class="opacity-45">·</span>
        <a
          href={alternateHref}
          hreflang={alternateLocale}
          lang={alternateLocale}
          class="font-medium text-ink-primary transition-colors hover:text-accent-link"
        >
          {alternateLabel}
        </a>
      </div>
    </div>
  </div>
</footer>
