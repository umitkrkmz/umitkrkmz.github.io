---
import { getCollection } from 'astro:content';
import type { Locale } from '../../data/site';
import { SITE_OWNER } from '../../data/site';
import { UI_STRINGS, getLocalePath } from '../../data/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreBadge from '../StoreBadge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI_STRINGS[locale];
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);

const title =
  locale === 'tr'
    ? `Windows Uygulamaları · ${SITE_OWNER.fullName}`
    : `Windows Applications · ${SITE_OWNER.fullName}`;

const copy =
  locale === 'tr'
    ? {
        subtitle:
          'Günlük işlerinizi hızlandıran, dosyalarınızı kendi bilgisayarınızda tutan ve abonelik gerektirmeyen sade Windows araçları.',
        trustPoints: [
          {
            icon: 'payment',
            title: 'Abonelik yok',
            note: 'Tek seferlik ödeme veya ücretsiz',
          },
          {
            icon: 'local',
            title: 'Dosyalarınız cihazda kalır',
            note: 'Buluta yükleme yok, tüm işlemler yerelde',
          },
          {
            icon: 'privacy',
            title: 'Hesap ve reklam yok',
            note: 'İzleme ve telemetri içermez',
          },
          {
            icon: 'store',
            title: 'Microsoft Store güvencesi',
            note: 'Temiz kurulum ve otomatik güncelleme',
          },
        ],
        storeCta: 'Microsoft Store’dan Edin',
        featuresCta: 'Özellikleri İncele',
        quickLinksTitle: 'Hızlı Belgeler ve Sürüm Bağlantıları',
      }
    : {
        subtitle:
          'Focused Windows tools that speed up everyday work, keep your files on your own PC, and never ask for a subscription.',
        trustPoints: [
          {
            icon: 'payment',
            title: 'No subscriptions',
            note: 'One-time purchase or free',
          },
          {
            icon: 'local',
            title: 'Files stay on your PC',
            note: 'No cloud uploads, processed locally',
          },
          {
            icon: 'privacy',
            title: 'No accounts or ads',
            note: 'Zero tracking and zero telemetry',
          },
          {
            icon: 'store',
            title: 'Microsoft Store delivery',
            note: 'Clean install and automatic updates',
          },
        ],
        storeCta: 'Get on Microsoft Store',
        featuresCta: 'Explore Features',
        quickLinksTitle: 'Quick Documentation & Release Links',
      };
---

<BaseLayout locale={locale} title={title} description={copy.subtitle}>
  <!-- Header & 4-Point Buyer Trust Strip -->
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8 sm:px-6 sm:pt-16 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wide text-ink-secondary">
        {ui.sections.storeAppsEyebrow}
      </p>
      <h1 class="mt-2.5 text-balance text-3xl font-semibold tracking-[-0.03em] text-ink-primary sm:text-4xl">
        {ui.sections.storeAppsTitle}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-secondary">
        {copy.subtitle}
      </p>
    </div>

    <!-- 4-Point Trust Strip (2×2 on mobile, 4 columns on desktop) -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {copy.trustPoints.map((point) => (
        <div class="rounded-2xl border border-border-subtle bg-surface-google p-4 sm:p-5">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-border-subtle bg-white text-ink-primary">
            {point.icon === 'payment' && (
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2.5" />
                <path d="M2 10h20" />
                <path d="M6 15h4" />
              </svg>
            )}
            {point.icon === 'local' && (
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="12" rx="2" />
                <path d="M2 20h20" />
              </svg>
            )}
            {point.icon === 'privacy' && (
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            )}
            {point.icon === 'store' && (
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                <path d="M3 6h18" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
            )}
          </span>
          <p class="mt-3 text-sm font-semibold tracking-[-0.01em] text-ink-primary">
            {point.title}
          </p>
          <p class="mt-1 text-xs leading-relaxed text-ink-secondary">
            {point.note}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Scalable Full-Width 2-Column Horizontal Product Showcases -->
  <section class="mx-auto max-w-6xl px-5 py-4 sm:px-6 lg:px-8">
    <div class="space-y-7">
      {apps.map(({ data: app }, idx) => {
        const loc = app[locale];
        const t = app.theme;
        const overviewHref = getLocalePath(locale, `/apps/${app.slug}/`);
        const privacyHref = getLocalePath(locale, `/apps/${app.slug}/privacy/`);
        const supportHref = getLocalePath(locale, `/apps/${app.slug}/support/`);
        const changelogHref = getLocalePath(locale, `/apps/${app.slug}/changelog/`);

        return (
          <article
            id={app.slug}
            style={`background: linear-gradient(150deg, ${t.surfaceFrom} 0%, ${t.surfaceTo} 100%); border-color: ${t.borderTint};`}
            class="group scroll-mt-20 overflow-visible rounded-3xl border p-6 sm:p-8 lg:p-10"
          >
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
              <!-- Left Column: Buyer-Focused Value, Concrete Use Cases & CTAs -->
              <div class="lg:col-span-5">
                <div class="flex items-center gap-3.5">
                  <a href={overviewHref} tabindex="-1" aria-hidden="true" class="shrink-0">
                    <img
                      src={app.icon}
                      alt=""
                      width="56"
                      height="56"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-14 w-14 [filter:drop-shadow(0_8px_16px_rgba(0,0,0,0.16))]"
                    />
                  </a>
                  <div class="min-w-0">
                    <h2 class="text-2xl font-semibold tracking-[-0.025em] text-ink-primary sm:text-[28px]">
                      <a href={overviewHref} class="hover:underline decoration-1 underline-offset-4">
                        {app.name}
                      </a>
                    </h2>
                    <p class="mt-1 inline-flex items-center rounded-full bg-white/85 px-2.5 py-0.5 text-xs font-medium text-ink-secondary ring-1 ring-black/[0.06]">
                      {loc.priceBadge}
                    </p>
                  </div>
                </div>

                <!-- 1-Sentence Primary Benefit -->
                <p class="mt-5 text-base font-medium leading-snug text-ink-primary sm:text-[17px]">
                  {loc.tagline}
                </p>

                <!-- 3 Concrete Everyday Use-Case Points -->
                <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-ink-secondary">
                  {loc.features.slice(0, 3).map((feature) => (
                    <li class="flex gap-2.5">
                      <svg
                        aria-hidden="true"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style={`color: ${t.accent};`}
                        class="mt-1 shrink-0"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <!-- Side-by-Side Dark Microsoft Store Badge (with Mascot Peek) & Secondary Pill CTA -->
                <div class="mt-11 flex flex-wrap items-center gap-3">
                  <StoreBadge
                    href={app.storeUrl}
                    locale={locale}
                    slug={app.slug}
                    accentColor={t.accent}
                    showMascot={true}
                  />

                  <a
                    href={overviewHref}
                    class="inline-flex h-[48px] items-center justify-center gap-1.5 rounded-[14px] border border-black/10 bg-white/95 px-5 text-sm font-medium text-ink-primary transition-colors hover:bg-white"
                  >
                    <span>{copy.featuresCta}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>

                <!-- Quiet Documentation Links + Subtle Version -->
                <div class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-medium text-ink-secondary">
                  <a href={privacyHref} class="transition-colors hover:text-ink-primary">
                    {ui.appTabs.privacy}
                  </a>
                  <span aria-hidden="true" class="opacity-45">·</span>
                  <a href={supportHref} class="transition-colors hover:text-ink-primary">
                    {ui.appTabs.support}
                  </a>
                  <span aria-hidden="true" class="opacity-45">·</span>
                  <a href={changelogHref} class="transition-colors hover:text-ink-primary">
                    {ui.appTabs.changelog}
                  </a>
                  <span aria-hidden="true" class="opacity-45">·</span>
                  <span class="font-normal">v{app.version}</span>
                </div>
              </div>

              <!-- Right Column: Large, Crisp Localized WebP Screenshot -->
              <a
                href={overviewHref}
                aria-label={`${app.name} — ${copy.featuresCta}`}
                class="relative block lg:col-span-7"
              >
                <div
                  aria-hidden="true"
                  style={`background: radial-gradient(70% 60% at 50% 85%, ${t.backdropTone}24 0%, transparent 75%);`}
                  class="pointer-events-none absolute -inset-x-4 -bottom-4 top-6 rounded-2xl"
                ></div>
                <div
                  style={`background-color: ${t.backdropTone}; box-shadow: 0 28px 54px -22px ${t.shadowTint}, 0 8px 18px -6px rgba(0, 0, 0, 0.14);`}
                  class="relative overflow-hidden rounded-2xl p-[1.5px] ring-1 ring-black/10 transition-transform duration-300 group-hover:scale-[1.01]"
                >
                  <div class="relative overflow-hidden rounded-[14.5px]">
                    <img
                      src={loc.cardImage}
                      alt={loc.cardImageAlt}
                      width="1600"
                      height="900"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="aspect-video w-full object-cover"
                    />
                    <div
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-0 rounded-[14.5px] ring-1 ring-inset ring-white/12"
                    ></div>
                  </div>
                </div>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Compact Single-Row Quick Documentation & Release Links Strip -->
  <section class="mx-auto max-w-6xl px-5 pt-10 pb-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-border-subtle bg-surface-google p-6 sm:px-8 sm:py-7">
      <h2 class="text-base font-semibold tracking-[-0.015em] text-ink-primary sm:text-lg">
        {copy.quickLinksTitle}
      </h2>

      <ul class="mt-4 divide-y divide-border-subtle">
        {apps.map(({ data: app }) => (
          <li class="flex flex-col gap-2.5 py-3.5 first:pt-1 last:pb-0 md:flex-row md:items-center md:justify-between">
            <div class="flex items-center gap-2.5">
              <img
                src={app.icon}
                alt=""
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
                class="h-6 w-6 shrink-0 rounded-[5px]"
              />
              <a
                href={getLocalePath(locale, `/apps/${app.slug}/`)}
                class="text-sm font-semibold text-ink-primary transition-colors hover:text-accent-link"
              >
                {app.name}
              </a>
              <span class="text-xs text-ink-secondary">v{app.version}</span>
            </div>

            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-xs font-medium text-ink-secondary sm:gap-x-2.5 sm:text-sm">
              <a href={getLocalePath(locale, `/apps/${app.slug}/`)} class="transition-colors hover:text-ink-primary">
                {ui.appTabs.overview}
              </a>
              <span aria-hidden="true" class="hidden opacity-45 sm:inline">·</span>
              <a href={getLocalePath(locale, `/apps/${app.slug}/privacy/`)} class="transition-colors hover:text-ink-primary">
                {ui.appTabs.privacy}
              </a>
              <span aria-hidden="true" class="hidden opacity-45 sm:inline">·</span>
              <a href={getLocalePath(locale, `/apps/${app.slug}/support/`)} class="transition-colors hover:text-ink-primary">
                {ui.appTabs.support}
              </a>
              <span aria-hidden="true" class="hidden opacity-45 sm:inline">·</span>
              <a href={getLocalePath(locale, `/apps/${app.slug}/changelog/`)} class="transition-colors hover:text-ink-primary">
                {ui.appTabs.changelog}
              </a>
              <span aria-hidden="true" class="hidden opacity-45 sm:inline">·</span>
              <a
                href={app.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent-link hover:underline"
              >
                Store ↗
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
