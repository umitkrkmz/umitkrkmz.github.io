---
import { getCollection } from 'astro:content';
import type { Locale } from '../../data/site';
import { SITE_OWNER } from '../../data/site';
import { UI_STRINGS } from '../../data/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShowcaseCard from '../ProjectShowcaseCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI_STRINGS[locale];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const engineeringProjects = projects.filter((p) => p.data.category === 'engineering');
const aiProjects = projects.filter((p) => p.data.category === 'ai');

const title =
  locale === 'tr'
    ? `Mühendislik ve Yapay Zekâ Projeleri · ${SITE_OWNER.fullName}`
    : `Engineering & AI Projects · ${SITE_OWNER.fullName}`;
const description = ui.sections.projectsSubtitle;
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8 sm:px-6 sm:pt-16 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wide text-ink-secondary">
        {ui.sections.projectsEyebrow}
      </p>
      <h1 class="mt-2.5 text-balance text-3xl font-semibold tracking-[-0.03em] text-ink-primary sm:text-4xl">
        {ui.sections.projectsTitle}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-secondary">
        {ui.sections.projectsSubtitle}
      </p>
    </div>
  </section>

  <!-- Engineering & Academic (3 projects) -->
  <section class="mx-auto max-w-6xl px-5 py-8 sm:px-6 lg:px-8">
    <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-primary">
      {ui.sections.engineeringCategory}
    </h2>
    <div class="mt-6 space-y-6">
      {engineeringProjects.map(({ data: project }) => (
        <ProjectShowcaseCard project={project} locale={locale} variant="card" />
      ))}
    </div>
  </section>

  <!-- AI Research & Engineering (2 projects) -->
  <section class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
    <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-primary">
      {ui.sections.aiCategory}
    </h2>
    <div class="mt-6 space-y-6">
      {aiProjects.map(({ data: project }) => (
        <ProjectShowcaseCard project={project} locale={locale} variant="card" />
      ))}
    </div>

    <div class="mt-12 rounded-2xl border border-border-subtle bg-surface-google p-6 sm:flex sm:items-center sm:justify-between">
      <p class="text-sm text-ink-secondary">
        {locale === 'tr'
          ? 'Diğer açık kaynak çalışmalarımı ve katkı geçmişimi GitHub profilimde inceleyebilirsiniz.'
          : 'Explore additional open-source repositories and commit history on GitHub.'}
      </p>
      <a
        href={SITE_OWNER.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border-subtle bg-white px-4 py-2 text-sm font-medium text-ink-primary transition-colors hover:bg-surface-apple sm:mt-0"
      >
        <span>{ui.actions.allProjectsOnGithub}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
