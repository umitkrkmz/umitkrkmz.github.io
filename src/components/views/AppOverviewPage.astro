---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/site';
import { UI_STRINGS, getLocalePath } from '../../data/ui';
import AppLayout from '../../layouts/AppLayout.astro';

interface Props {
  app: CollectionEntry<'apps'>['data'];
  locale: Locale;
}

const { app, locale } = Astro.props;
const ui = UI_STRINGS[locale];
const localized = app[locale];
const { theme } = app;

const allApps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const otherApps = allApps.filter((entry) => entry.data.slug !== app.slug);

const shots =
  localized.screenshots.length > 0
    ? localized.screenshots
    : [{ src: localized.heroImage, alt: localized.heroAlt, caption: '' }];

const hasTierComparison = app.slug === 'foliopeek' || app.sourceModel === 'open-source';

const networkDetail =
  app.networkModel === 'offline'
    ? locale === 'tr'
      ? 'Tamamen çevrimdışı (ağ erişimi yok)'
      : 'Strictly offline (no network access)'
    : locale === 'tr'
      ? 'Yerel öncelikli (geliştirici sunucusu ve telemetri yok)'
      : 'Local-first (no developer server or telemetry)';

const sourceDetail =
  locale === 'tr'
    ? app.licenseLabel
    : app.sourceModel === 'open-source'
      ? 'GPL-3.0-or-later (Open Source)'
      : 'Closed Source · Open Documentation (CC BY 4.0)';

const tablePeekSteps =
  locale === 'tr'
    ? [
        {
          title: 'Tabloyu seçin',
          body: 'Ctrl + Alt + Shift + T kısayoluyla ekrandaki, resim dosyasındaki veya panodaki tabloyu çerçeveleyin.',
        },
        {
          title: 'Stüdyo’da denetleyin',
          body: 'Windows’un yerleşik OCR motoru satır ve sütunları yerelde okur; gerekirse sütun sınırlarını sürükleyip hücreleri yeniden okuyun.',
        },
        {
          title: 'Excel’e aktarın',
          body: 'Sayıları, para birimlerini ve tarihleri gerçek değer olarak yapıştırın veya filtreli .xlsx dosyası olarak kaydedin.',
        },
      ]
    : [
        {
          title: 'Select any table',
          body: 'Press Ctrl + Alt + Shift + T to frame a table on screen, or open one from an image file or your clipboard.',
        },
        {
          title: 'Review in Studio',
          body: 'Built-in Windows OCR detects rows and columns locally; drag column dividers or re-read single cells whenever needed.',
        },
        {
          title: 'Paste into Excel',
          body: 'Copy real numbers, currencies, and dates with formatting—or save directly as a filtered .xlsx workbook.',
        },
      ];

const copy =
  locale === 'tr'
    ? {
        zoomLabel: 'Görseli büyüt',
        zoomHint: 'Büyüt',
        closeLabel: 'Kapat',
        prevImage: 'Önceki ekran görüntüsü',
        nextImage: 'Sonraki ekran görüntüsü',
        thumbsLabel: 'Ekran görüntüsü önizlemeleri',
        howItWorksTitle: 'Nasıl Çalışır?',
        pricingHeading: 'Fiyat ve Sürüm Özeti',
        privacyHeading: 'Gizlilik Özeti',
        fullPrivacyLink: 'Gizlilik politikasının tamamı',
        techHeading: 'Teknik Bilgiler',
        platformLabel: 'Platform',
        versionLabel: 'Sürüm ve Tarih',
        networkLabel: 'Ağ ve İzinler',
        sourceLabel: 'Kaynak ve Lisans',
        requirementsLabel: 'Sistem Notları',
        otherAppsTitle: 'Diğer Windows Uygulamaları',
        allAppsLink: 'Tümünü incele',
        inspectApp: 'İncele',
        fullSupportGuide: 'Tüm destek kılavuzu',
      }
    : {
        zoomLabel: 'Enlarge screenshot',
        zoomHint: 'Zoom',
        closeLabel: 'Close',
        prevImage: 'Previous screenshot',
        nextImage: 'Next screenshot',
        thumbsLabel: 'Screenshot thumbnails',
        howItWorksTitle: 'How It Works',
        pricingHeading: 'Pricing & Editions',
        privacyHeading: 'Privacy at a Glance',
        fullPrivacyLink: 'Read full privacy policy',
        techHeading: 'Technical Details',
        platformLabel: 'Platform',
        versionLabel: 'Version & Release',
        networkLabel: 'Network & Permissions',
        sourceLabel: 'Source & License',
        requirementsLabel: 'System Notes',
        otherAppsTitle: 'More Windows Applications',
        allAppsLink: 'Explore all',
        inspectApp: 'Explore',
        fullSupportGuide: 'Full support guide',
      };
---

<AppLayout app={app} locale={locale} activeTab="overview">
  <!-- 1. Interactive Screenshot Gallery + Native <dialog> Lightbox -->
  <section aria-label={ui.sections.screenshotsTitle} data-app-gallery>
    <div
      style={`background: linear-gradient(160deg, ${theme.surfaceFrom} 0%, ${theme.surfaceTo} 100%); border-color: ${theme.borderTint};`}
      class="relative overflow-hidden rounded-3xl border p-4 sm:p-7 lg:p-8"
    >
      <div
        aria-hidden="true"
        style={`background: radial-gradient(65% 55% at 50% 85%, ${theme.backdropTone}24 0%, transparent 75%);`}
        class="pointer-events-none absolute inset-x-4 bottom-0 top-8"
      ></div>

      <!-- Main Stage Image Button (Opens Native Lightbox) -->
      <div class="relative mx-auto max-w-4xl">
        <button
          type="button"
          data-gallery-zoom
          aria-label={`${app.name} — ${copy.zoomLabel}`}
          style={`background-color: ${theme.backdropTone}; box-shadow: 0 28px 54px -22px ${theme.shadowTint}, 0 8px 18px -6px rgba(0, 0, 0, 0.14);`}
          class="group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl p-[1.5px] text-left ring-1 ring-black/10 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          <div class="relative overflow-hidden rounded-[14.5px]">
            <img
              data-gallery-main
              src={shots[0].src}
              alt={shots[0].alt}
              width="1600"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.01]"
            />
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 rounded-[14.5px] ring-1 ring-inset ring-white/12"
            ></div>
            <span class="pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-black/70 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm transition-opacity sm:opacity-85 sm:group-hover:opacity-100">
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
                <path d="M11 8v6" />
                <path d="M8 11h6" />
              </svg>
              <span>{copy.zoomHint}</span>
            </span>
          </div>
        </button>

        <!-- Active Caption + Counter -->
        {(shots[0].caption || shots.length > 1) && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-ink-secondary sm:text-sm">
            <p data-gallery-caption class="min-w-0 flex-1 leading-relaxed">
              {shots[0].caption ?? ''}
            </p>
            {shots.length > 1 && (
              <span data-gallery-counter class="shrink-0 font-medium tabular-nums">
                1 / {shots.length}
              </span>
            )}
          </div>
        )}

        <!-- Clickable Thumbnail Strip (Hidden automatically when only 1 screenshot exists) -->
        {shots.length > 1 && (
          <div
            role="group"
            aria-label={copy.thumbsLabel}
            class:list={[
              'mt-4 flex gap-2.5 overflow-x-auto p-1 [scrollbar-width:none] sm:grid [&::-webkit-scrollbar]:hidden',
              shots.length <= 4 ? 'sm:grid-cols-4' : 'sm:grid-cols-4 md:grid-cols-6',
            ]}
          >
            {shots.map((shot, idx) => (
              <button
                type="button"
                data-gallery-thumb={idx}
                data-src={shot.src}
                data-alt={shot.alt}
                data-caption={shot.caption ?? ''}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                aria-label={shot.caption || shot.alt}
                style={`--thumb-ring: ${theme.accent};`}
                class:list={[
                  'w-28 shrink-0 cursor-pointer overflow-hidden rounded-xl border bg-white/80 p-1 transition-all sm:w-auto',
                  idx === 0
                    ? 'border-transparent ring-2 ring-[var(--thumb-ring)] opacity-100'
                    : 'border-black/10 opacity-70 hover:opacity-100',
                ]}
              >
                <img
                  src={shot.src}
                  alt=""
                  width="320"
                  height="180"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                  class="aspect-video w-full rounded-lg object-cover"
                />
              </button>
            ))}
          </div>
        )}
      </div>
    </div>

    {localized.mediaCredit && (
      <p class="mt-3 text-xs leading-relaxed text-ink-secondary">
        {localized.mediaCredit}
      </p>
    )}

    <!-- Native <dialog> Lightbox -->
    <dialog
      data-gallery-dialog
      aria-label={`${app.name} — ${ui.sections.screenshotsTitle}`}
      class="m-auto w-[min(94vw,1220px)] max-w-none overflow-hidden rounded-3xl border border-white/10 bg-[#141517] p-0 text-white shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    >
      <div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-3.5 sm:px-6">
        <div class="flex min-w-0 items-center gap-3 text-xs text-white/80 sm:text-sm">
          <span class="font-semibold text-white">{app.name}</span>
          {shots.length > 1 && (
            <span data-dialog-counter class="tabular-nums text-white/65">
              1 / {shots.length}
            </span>
          )}
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label={copy.closeLabel}
          class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/20"
        >
          <span>{copy.closeLabel}</span>
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <div class="relative bg-black/40 p-3 sm:p-5">
        <img
          data-dialog-img
          src={shots[0].src}
          alt={shots[0].alt}
          width="1600"
          height="900"
          class="mx-auto aspect-video max-h-[74vh] w-full rounded-xl object-contain"
        />

        {shots.length > 1 && (
          <div class="mt-3 flex items-center justify-between gap-3">
            <p data-dialog-caption class="min-w-0 flex-1 text-xs leading-relaxed text-white/80 sm:text-sm">
              {shots[0].caption ?? ''}
            </p>
            <div class="flex shrink-0 items-center gap-2">
              <button
                type="button"
                data-dialog-prev
                aria-label={copy.prevImage}
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m15 18-6-6 6-6" />
                </svg>
              </button>
              <button
                type="button"
                data-dialog-next
                aria-label={copy.nextImage}
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </button>
            </div>
          </div>
        )}
      </div>
    </dialog>
  </section>

  <!-- 2. Editorial Summary -->
  <section class="mt-12 max-w-[68ch]">
    <p class="text-base leading-relaxed text-ink-primary sm:text-lg sm:leading-relaxed">
      {localized.description}
    </p>
    <p class="mt-3.5 text-[15px] leading-relaxed text-ink-secondary">
      {localized.shortDescription}
    </p>
  </section>

  <!-- 3. Key Features (2-Column Readable Grid) -->
  <section class="mt-14 border-t border-border-subtle pt-12">
    <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-primary">
      {ui.sections.featuresTitle}
    </h2>
    <ul class="mt-6 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
      {localized.features.map((feat) => (
        <li class="flex gap-3 rounded-2xl border border-border-subtle bg-white p-4 text-sm leading-relaxed text-ink-secondary">
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style={`color: ${theme.accent};`}
            class="mt-1 shrink-0"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Pricing / Editions Summary (Multi-Tier Apps) OR How It Works (Single-Tier App: TablePeek) -->
  <section class="mt-14 border-t border-border-subtle pt-12">
    {hasTierComparison ? (
      <div class="rounded-3xl border border-border-subtle bg-surface-google p-6 sm:p-8">
        <div class="max-w-2xl">
          <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-primary sm:text-2xl">
            {copy.pricingHeading}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-secondary sm:text-[15px]">
            {localized.pricingSummary}
          </p>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {localized.pricingTiers.map((tier) => (
            <div class="flex flex-col justify-between rounded-2xl border border-border-subtle bg-white p-5 sm:p-6">
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-base font-semibold text-ink-primary">{tier.label}</h3>
                  <span
                    style={`background-color: ${theme.badgeBg}; color: ${theme.badgeText};`}
                    class="rounded-full px-3 py-0.5 text-xs font-semibold"
                  >
                    {tier.price}
                  </span>
                </div>
                {tier.note && (
                  <p class="mt-2.5 text-sm leading-relaxed text-ink-secondary">{tier.note}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="rounded-3xl border border-border-subtle bg-surface-google p-6 sm:p-8">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-primary sm:text-2xl">
              {copy.howItWorksTitle}
            </h2>
            <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-ink-secondary">
              {localized.pricingSummary}
            </p>
          </div>
          <span
            style={`background-color: ${theme.badgeBg}; color: ${theme.badgeText};`}
            class="inline-flex w-fit shrink-0 rounded-full px-3 py-1 text-xs font-semibold"
          >
            {localized.priceBadge}
          </span>
        </div>

        <ol class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {tablePeekSteps.map((step, sIdx) => (
            <li class="rounded-2xl border border-border-subtle bg-white p-5">
              <span
                style={`background-color: ${theme.badgeBg}; color: ${theme.badgeText};`}
                class="inline-flex h-7 w-7 items-center justify-center rounded-full text-xs font-semibold"
              >
                {sIdx + 1}
              </span>
              <h3 class="mt-3.5 text-sm font-semibold text-ink-primary sm:text-[15px]">
                {step.title}
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-secondary sm:text-sm">
                {step.body}
              </p>
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>

  <!-- 5. Privacy Summary + Technical Details (Balanced Equal-Height 2 Columns) -->
  <section class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Left Card: Privacy at a Glance -->
    <div class="flex flex-col justify-between rounded-3xl border border-border-subtle bg-surface-google p-6 sm:p-8">
      <div>
        <h2 class="text-lg font-semibold tracking-[-0.015em] text-ink-primary">
          {copy.privacyHeading}
        </h2>
        <ul class="mt-5 space-y-3 rounded-2xl border border-border-subtle bg-white p-5 text-sm leading-relaxed text-ink-secondary">
          {localized.privacyHighlights.map((item) => (
            <li class="flex gap-2.5">
              <span
                aria-hidden="true"
                style={`background-color: ${theme.accent};`}
                class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full opacity-80"
              ></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-6 pt-1">
        <a
          href={getLocalePath(locale, `/apps/${app.slug}/privacy/`)}
          style={`color: ${theme.accent};`}
          class="inline-flex items-center gap-1 text-sm font-semibold transition-opacity hover:opacity-80"
        >
          <span>{copy.fullPrivacyLink}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Right Card: Technical Details (Houses Source/License, Platform, Version, Network) -->
    <div class="flex flex-col justify-between rounded-3xl border border-border-subtle bg-surface-google p-6 sm:p-8">
      <div>
        <h2 class="text-lg font-semibold tracking-[-0.015em] text-ink-primary">
          {copy.techHeading}
        </h2>
        <dl class="mt-5 divide-y divide-border-subtle rounded-2xl border border-border-subtle bg-white px-5 text-sm">
          <div class="py-3">
            <dt class="text-xs font-medium text-ink-secondary">{copy.platformLabel}</dt>
            <dd class="mt-0.5 font-medium text-ink-primary">{localized.requirements[0]}</dd>
          </div>
          <div class="py-3">
            <dt class="text-xs font-medium text-ink-secondary">{copy.versionLabel}</dt>
            <dd class="mt-0.5 font-medium text-ink-primary">v{app.version} · {app.releaseDate}</dd>
          </div>
          <div class="py-3">
            <dt class="text-xs font-medium text-ink-secondary">{copy.networkLabel}</dt>
            <dd class="mt-0.5 font-medium text-ink-primary">{networkDetail}</dd>
          </div>
          <div class="py-3">
            <dt class="text-xs font-medium text-ink-secondary">{copy.sourceLabel}</dt>
            <dd class="mt-0.5 font-medium text-ink-primary">{sourceDetail}</dd>
          </div>
          {localized.requirements.length > 1 && (
            <div class="py-3">
              <dt class="text-xs font-medium text-ink-secondary">{copy.requirementsLabel}</dt>
              <dd class="mt-0.5 text-xs leading-relaxed text-ink-secondary">
                {localized.requirements.slice(1).join(' · ')}
              </dd>
            </div>
          )}
        </dl>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 pt-1 text-sm">
        <a
          href={getLocalePath(locale, `/apps/${app.slug}/changelog/`)}
          class="font-medium text-accent-link hover:underline"
        >
          {ui.appTabs.changelog} (v{app.version}) →
        </a>
        <span aria-hidden="true" class="text-border-subtle">·</span>
        <a
          href={getLocalePath(locale, `/apps/${app.slug}/support/`)}
          class="text-ink-secondary transition-colors hover:text-ink-primary"
        >
          {ui.appTabs.support} →
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Zero-JS FAQ Accordion -->
  <section class="mt-14 border-t border-border-subtle pt-12">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-primary">
        {ui.sections.faqTitle}
      </h2>
      <a
        href={getLocalePath(locale, `/apps/${app.slug}/support/`)}
        class="text-sm font-medium text-accent-link hover:underline"
      >
        {copy.fullSupportGuide} →
      </a>
    </div>

    <div class="mt-6 max-w-3xl divide-y divide-border-subtle rounded-3xl border border-border-subtle bg-white">
      {localized.faqs.map((faq) => (
        <details class="group p-5 sm:px-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-ink-primary sm:text-[15px] [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <span
              aria-hidden="true"
              class="shrink-0 text-ink-secondary transition-transform duration-200 group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="mt-3 max-w-[64ch] text-sm leading-relaxed text-ink-secondary">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- 7. Cross-Discovery Strip: Other Windows Applications (Dynamic for 5+ Apps) -->
  {otherApps.length > 0 && (
    <section class="mt-14 border-t border-border-subtle pt-12">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-primary sm:text-2xl">
          {copy.otherAppsTitle}
        </h2>
        <a
          href={getLocalePath(locale, '/apps/')}
          class="text-sm font-medium text-accent-link hover:underline"
        >
          {copy.allAppsLink} →
        </a>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {otherApps.map(({ data: other }) => {
          const oLoc = other[locale];
          const oTheme = other.theme;
          const oHref = getLocalePath(locale, `/apps/${other.slug}/`);
          return (
            <a
              href={oHref}
              style={`background: linear-gradient(155deg, ${oTheme.surfaceFrom} 0%, ${oTheme.surfaceTo} 100%); border-color: ${oTheme.borderTint};`}
              class="group flex flex-col justify-between rounded-3xl border p-5 transition-transform duration-200 hover:-translate-y-0.5"
            >
              <div>
                <div class="flex items-center gap-3">
                  <img
                    src={other.icon}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                    class="h-10 w-10 shrink-0 [filter:drop-shadow(0_5px_10px_rgba(0,0,0,0.14))]"
                  />
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold tracking-[-0.015em] text-ink-primary">
                      {other.name}
                    </h3>
                    <p class="truncate text-xs text-ink-secondary">
                      {oLoc.priceBadge}
                    </p>
                  </div>
                </div>
                <p class="mt-3 line-clamp-2 text-xs leading-relaxed text-ink-secondary sm:text-sm">
                  {oLoc.tagline}
                </p>
              </div>
              <p
                style={`color: ${oTheme.accent};`}
                class="mt-4 inline-flex items-center gap-1 text-xs font-semibold sm:text-sm"
              >
                <span>{copy.inspectApp}</span>
                <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
              </p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Lightweight Overview-Only Vanilla JS for Thumbnail Switching & Native <dialog> Lightbox -->
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-app-gallery]');
      if (!root) return;

      const mainImg = root.querySelector('[data-gallery-main]');
      const captionEl = root.querySelector('[data-gallery-caption]');
      const counterEl = root.querySelector('[data-gallery-counter]');
      const zoomBtn = root.querySelector('[data-gallery-zoom]');
      const thumbs = [...root.querySelectorAll('[data-gallery-thumb]')];
      const dialog = root.querySelector('[data-gallery-dialog]');
      const dialogImg = root.querySelector('[data-dialog-img]');
      const dialogCaption = root.querySelector('[data-dialog-caption]');
      const dialogCounter = root.querySelector('[data-dialog-counter]');
      const dialogClose = root.querySelector('[data-dialog-close]');
      const dialogPrev = root.querySelector('[data-dialog-prev]');
      const dialogNext = root.querySelector('[data-dialog-next]');

      const items = thumbs.length
        ? thumbs.map((btn) => ({
            src: btn.getAttribute('data-src') || '',
            alt: btn.getAttribute('data-alt') || '',
            caption: btn.getAttribute('data-caption') || '',
          }))
        : mainImg
          ? [
              {
                src: mainImg.getAttribute('src') || '',
                alt: mainImg.getAttribute('alt') || '',
                caption: captionEl ? captionEl.textContent || '' : '',
              },
            ]
          : [];

      if (!items.length || !mainImg) return;
      let current = 0;

      const activeClasses = ['border-transparent', 'ring-2', 'ring-[var(--thumb-ring)]', 'opacity-100'];
      const idleClasses = ['border-black/10', 'opacity-70', 'hover:opacity-100'];

      const select = (index) => {
        const total = items.length;
        current = ((index % total) + total) % total;
        const item = items[current];

        mainImg.setAttribute('src', item.src);
        mainImg.setAttribute('alt', item.alt);
        if (captionEl) captionEl.textContent = item.caption;
        if (counterEl) counterEl.textContent = `${current + 1} / ${total}`;

        if (dialogImg) {
          dialogImg.setAttribute('src', item.src);
          dialogImg.setAttribute('alt', item.alt);
        }
        if (dialogCaption) dialogCaption.textContent = item.caption;
        if (dialogCounter) dialogCounter.textContent = `${current + 1} / ${total}`;

        thumbs.forEach((btn, i) => {
          const isActive = i === current;
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            btn.classList.remove(...idleClasses);
            btn.classList.add(...activeClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...idleClasses);
          }
        });
      };

      thumbs.forEach((btn, i) => {
        btn.addEventListener('click', () => select(i));
      });

      if (zoomBtn && dialog && typeof dialog.showModal === 'function') {
        zoomBtn.addEventListener('click', () => {
          select(current);
          dialog.showModal();
        });
        dialogClose?.addEventListener('click', () => dialog.close());
        dialogPrev?.addEventListener('click', () => select(current - 1));
        dialogNext?.addEventListener('click', () => select(current + 1));

        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });

        dialog.addEventListener('keydown', (e) => {
          if (items.length <= 1) return;
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            select(current + 1);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            select(current - 1);
          }
        });
      }
    })();
  </script>
</AppLayout>
